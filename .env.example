# Set variables in the backend process environment; .env is not auto-loaded.
# Development identity is NOT production authentication. Keep this mode local-only.
RINGSENTINEL_ENVIRONMENT=development
RINGSENTINEL_DATABASE_URL=sqlite:///./work/ringsentinel.db
RINGSENTINEL_STORAGE_ROOT=work/storage
RINGSENTINEL_AUTH_MODE=development
# Production adapter: set mode=jwt, environment=production, demo_enabled=false.
# Supply public verification keys only, never signing keys. See docs/phase5c-hardening.md.
# RINGSENTINEL_AUTH_JWKS_PATH=/run/config/access-token-public-jwks.json
# RINGSENTINEL_AUTH_ISSUER=https://identity.example
# RINGSENTINEL_AUTH_AUDIENCE=ringsentinel
RINGSENTINEL_AUTH_REQUIRED_SCOPE=ringsentinel:analyst
RINGSENTINEL_AUTH_MAX_TOKEN_SECONDS=900
# Production Host allowlist defaults to frontend-origin hosts plus private health loopback.
# RINGSENTINEL_TRUSTED_HOSTS=["analyst.example","127.0.0.1","localhost"]
RINGSENTINEL_DEVELOPMENT_USER_ID=local-analyst
RINGSENTINEL_DEMO_ENABLED=true
RINGSENTINEL_JOBS_ENABLED=true
RINGSENTINEL_FRONTEND_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
RINGSENTINEL_API_HOST=127.0.0.1
RINGSENTINEL_API_PORT=8000
RINGSENTINEL_LOG_LEVEL=INFO
RINGSENTINEL_UPLOAD_LIMIT_BYTES=25000000
RINGSENTINEL_ANALYSIS_TIMEOUT_SECONDS=300
RINGSENTINEL_BUILD_COMMIT=unknown
# Optional only. Default needs no key and makes no external model calls.
RINGSENTINEL_LLM_PROVIDER=deterministic
# To opt into OpenAI, set provider=openai and supply your own server-side key.
OPENAI_API_KEY=
RINGSENTINEL_OPENAI_MODEL=gpt-5.4-mini
RINGSENTINEL_LLM_TIMEOUT_SECONDS=20
RINGSENTINEL_LLM_RETRY_COUNT=0
RINGSENTINEL_LLM_MAX_OUTPUT_TOKENS=1200
# Frontend build-time public origin; empty = same-origin proxy. Never put secrets here.
NEXT_PUBLIC_RINGSENTINEL_API_BASE_URL=
# Backend target used by the frontend server's rewrite/proxy; set at build AND start.
RINGSENTINEL_API_PROXY_TARGET=http://127.0.0.1:8000
# Compose only: supply a local password in the shell, not this committed template.
RINGSENTINEL_DB_PASSWORD=
