# Optional only. Default demo needs no key and makes no external model calls.
# Set variables in the backend process environment; .env is not auto-loaded.
RINGSENTINEL_LLM_PROVIDER=deterministic
# To opt into OpenAI, set provider=openai and supply your own server-side key.
OPENAI_API_KEY=
RINGSENTINEL_OPENAI_MODEL=gpt-5.4-mini
