# syntax=docker/dockerfile:1
FROM node:24.19.0-bookworm-slim AS builder
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
# Next.js resolves rewrites into the production build. This contains no secret.
ARG RINGSENTINEL_API_PROXY_TARGET=http://backend:8000
ARG NEXT_PUBLIC_RISKWEAVE_OIDC_AUTHORITY
ARG NEXT_PUBLIC_RISKWEAVE_OIDC_CLIENT_ID
ENV NEXT_PUBLIC_RISKWEAVE_OIDC_AUTHORITY=$NEXT_PUBLIC_RISKWEAVE_OIDC_AUTHORITY \
    NEXT_PUBLIC_RISKWEAVE_OIDC_CLIENT_ID=$NEXT_PUBLIC_RISKWEAVE_OIDC_CLIENT_ID
ENV RINGSENTINEL_API_PROXY_TARGET=$RINGSENTINEL_API_PROXY_TARGET \
    RINGSENTINEL_ENVIRONMENT=production \
    RINGSENTINEL_STANDALONE=true
RUN npm run build

FROM node:24.19.0-bookworm-slim AS runtime
ENV NODE_ENV=production RINGSENTINEL_ENVIRONMENT=production HOSTNAME=0.0.0.0 PORT=5173
WORKDIR /app
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
COPY --from=builder --chown=node:node /app/public ./public
USER node
EXPOSE 5173
HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:5173/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server.js"]
